
{
  "version": 1,
  "author": "BCA Smart Home",
  "editor": "wokwi",
  "parts": [
    {
      "type": "board-esp32-devkit-c-v4",
      "id": "esp",
      "top": 0,
      "left": 0,
      "attrs": {
        "builder": "esp-idf"
      }
    },
    {
      "type": "wokwi-photoresistor-sensor",
      "id": "ldr1",
      "top": -80,
      "left": 200,
      "attrs": {
        "lux": "30"
      }
    },
    {
      "type": "wokwi-led",
      "id": "lamp1",
      "top": 100,
      "left": 240,
      "attrs": {
        "color": "yellow",
        "label": "Smart Lamp"
      }
    },
    {
      "type": "wokwi-resistor",
      "id": "r1",
      "top": 160,
      "left": 240,
      "attrs": {
        "value": "220"
      }
    }
  ],
  "connections": [
    ["esp:TX", "$serialMonitor:RX", "", []],
    ["esp:RX", "$serialMonitor:TX", "", []],

    ["ldr1:VCC", "esp:3V3", "red", []],
    ["ldr1:GND", "esp:GND.1", "black", []],
    ["ldr1:AO", "esp:34", "green", []],

    ["esp:18", "r1:1", "green", []],
    ["r1:2", "lamp1:A", "green", []],
    ["lamp1:C", "esp:GND.1", "black", []]
  ]
}
